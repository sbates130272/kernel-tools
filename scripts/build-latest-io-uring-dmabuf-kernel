#!/bin/bash
#
# (c) Stephen Bates, 2025
#
# A helper script to build a kernel with Pavel Begunkov's io_uring DMA-BUF
# patchset plus Anuj Gupta's filesystem (iomap/XFS) DMA-BUF extensions,
# enabling P2P direct I/O from NVMe storage into AMD GPU VRAM without staging
# through host RAM, including via filesystem paths.
#
# Source: Anuj Gupta's fs-dmabuf-rfc-v11-desc-v2 branch, which carries the
# full v11 io_uring DMA-BUF series (merged into Jens' for-next) plus 4
# additional patches adding block-layer refactoring, iomap guards, and XFS
# support:
#
#   https://github.com/anuj7781/linux-kernel  branch: anuj/fs-dmabuf-rfc-v11-desc-v2
#
# There is no local patch directory; the feature is built directly from that
# tree.
#
# An example call:
#
#   ./scripts/build-latest-io-uring-dmabuf-kernel
#
# Override any variable on the command line as needed, e.g.:
#
#   REMOTE_BRANCH=anuj/fs-dmabuf-rfc-v11-desc-v3 ./scripts/build-latest-io-uring-dmabuf-kernel

CONFIG=${CONFIG:-./useful-configs/config-x86_64-p2pdma-qemu}
REMOTE_BRANCH=${REMOTE_BRANCH:-anuj/fs-dmabuf-rfc-v11-desc-v2}
REMOTE=${REMOTE:-https://github.com/anuj7781/linux-kernel}

export CONFIG
export REMOTE_BRANCH
export REMOTE

THREADS=128 \
    ./scripts/build-kernel-debrpm
