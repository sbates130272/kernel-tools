#!/bin/bash
#
# (c) Stephen Bates, 2025
#
# A helper script to build a kernel with Pavel Begunkov's io_uring DMA-BUF
# patchset, enabling P2P direct I/O from NVMe storage into AMD GPU VRAM
# without staging through host RAM.
#
# The patchset (v11, 13 patches) is merged into Jens Axboe's for-next tree:
#
#   git://git.kernel.dk/linux  branch: for-next
#
# There is no longer a local patch directory; the feature is built directly
# from that tree.
#
# An example call:
#
#   ./scripts/build-latest-io-uring-dmabuf-kernel
#
# Override any variable on the command line as needed, e.g.:
#
#   REMOTE_BRANCH=for-6.15 ./scripts/build-latest-io-uring-dmabuf-kernel

CONFIG=${CONFIG:-./useful-configs/config-x86_64-p2pdma}
REMOTE_BRANCH=${REMOTE_BRANCH:-for-next}
REMOTE=${REMOTE:-git://git.kernel.dk/linux}

export CONFIG
export REMOTE_BRANCH
export REMOTE

THREADS=128 \
    ./scripts/build-kernel-debrpm
