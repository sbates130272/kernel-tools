#!/bin/bash
#
# (c) Stephen Bates, 2026
#
# Wrapper that runs fast-build-amdgpu inside the amdgpu-dkms-build Docker
# container, keeping all build artefacts and ccache off the host filesystem.
#
# Volumes used:
#   amdgpu-dkms-ccache   — ccache data (persists across container runs)
#   amdgpu-dkms-buildout — kernel build objects (.o/.cmd/.ko files)
#
# The staged source directory (BUILD_SRC) is bind-mounted read-only; the
# build script rsyncs it into the buildout volume on first run (or after
# FORCE=yes), so only changed translation units are recompiled on subsequent
# runs.
#
# Usage:
#   KERNEL_VER=6.8.0-142-generic \
#   BUILD_SRC=/usr/src/amdgpu-amdgpu-roc-7.2.x-<sha> \
#   ./scripts/docker-fast-build-amdgpu
#
# Key environment variables (all optional with defaults):
#   KERNEL_VER   — kernel to build against        [required]
#   BUILD_SRC    — pre-staged amdgpu source dir   [required]
#   AMDGPU_REF   — git ref (used when BUILD_SRC not set) [rocm-6.2.4]
#   PATCH_DIRS   — colon-separated patch dirs     []
#   INSTALL      — install .ko files (yes/no)     [no]
#   FORCE        — force full re-stage+build       [no]
#   IMAGE        — Docker image to use            [amdgpu-dkms-build:<KERNEL_VER>]
#   CCACHE_MAXSIZE — max ccache size              [10G]
#   BUILD_OUT_BASE — path inside the container    [/buildout]
#
# Build the image (once, or after Dockerfile changes):
#   docker buildx build --builder default \
#     --build-arg KERNEL_VER=6.8.0-142-generic \
#     -f docker/Dockerfile.amdgpu-dkms \
#     -t amdgpu-dkms-build:6.8.0-142-generic \
#     --load .
#

set -eo pipefail

KERNEL_VER=${KERNEL_VER:?'KERNEL_VER must be set'}
BUILD_SRC=${BUILD_SRC:-}
AMDGPU_REF=${AMDGPU_REF:-rocm-6.2.4}
# KERNEL_DIR: path to the kernel git repo on the host.  Used when BUILD_SRC
# is not set so fast-build-amdgpu can run git archive to stage the source.
# Resolved to an absolute path before being bind-mounted into the container.
KERNEL_DIR=${KERNEL_DIR:-}
PATCH_DIRS=${PATCH_DIRS:-}
INSTALL=${INSTALL:-no}
FORCE=${FORCE:-no}
CCACHE_MAXSIZE=${CCACHE_MAXSIZE:-10G}
BUILD_OUT_BASE=${BUILD_OUT_BASE:-/buildout}
IMAGE=${IMAGE:-amdgpu-dkms-build:${KERNEL_VER}}

REPO_ROOT=$(cd "$(dirname "$0")/.." && pwd)

# Resolve KERNEL_DIR to an absolute path (it may be relative to the caller's cwd).
if [ -n "${KERNEL_DIR}" ]; then
    KERNEL_DIR=$(cd "${KERNEL_DIR}" 2>/dev/null && pwd) \
        || { echo "Error. KERNEL_DIR '${KERNEL_DIR}' not found." >&2; exit 1; }
fi

# ---------------------------------------------------------------------------
# Validate BUILD_SRC: must exist on the host when supplied
if [ -n "${BUILD_SRC}" ] && [ ! -d "${BUILD_SRC}" ]; then
    echo "Error. BUILD_SRC '${BUILD_SRC}' not found." >&2
    exit 1
fi

# The kernel headers and module symlink tree must be accessible inside the
# container.  When the image was built with KERNEL_VER baked in (via
# --build-arg KERNEL_VER=...) the headers are already present inside the
# image and host bind-mounts are not required.  Set HEADERS_IN_IMAGE=yes
# to skip the bind-mount checks and rely on the baked-in headers.
HEADERS_IN_IMAGE=${HEADERS_IN_IMAGE:-no}

KMOD_HOST="/lib/modules/${KERNEL_VER}"
KHDRS_HOST="/usr/src/linux-headers-${KERNEL_VER}"

if [ "${HEADERS_IN_IMAGE}" != "yes" ]; then
    if [ ! -d "${KMOD_HOST}" ]; then
        echo "Error. ${KMOD_HOST} not found on host." >&2
        echo "       Set HEADERS_IN_IMAGE=yes if headers are baked into the image." >&2
        exit 1
    fi
    if [ ! -d "${KHDRS_HOST}" ]; then
        echo "Error. ${KHDRS_HOST} not found on host." >&2
        echo "       Set HEADERS_IN_IMAGE=yes if headers are baked into the image." >&2
        exit 1
    fi
fi

# ---------------------------------------------------------------------------
# Ensure named volumes exist (docker volume create is idempotent)
docker volume create amdgpu-dkms-ccache  >/dev/null 2>&1 || true
docker volume create amdgpu-dkms-buildout >/dev/null 2>&1 || true

# ---------------------------------------------------------------------------
# Build the fast-build command to run inside the container.
# Pass relevant environment variables through explicitly.

DOCKER_ARGS=(
    --rm
    -e "KERNEL_VER=${KERNEL_VER}"
    -e "AMDGPU_REF=${AMDGPU_REF}"
    -e "INSTALL=${INSTALL}"
    -e "FORCE=${FORCE}"
    -e "BUILD_OUT_BASE=${BUILD_OUT_BASE}"
    -e "CCACHE_DIR=/ccache"
    -e "CCACHE_MAXSIZE=${CCACHE_MAXSIZE}"
    # persistent ccache and build output volumes
    -v "amdgpu-dkms-ccache:/ccache"
    -v "amdgpu-dkms-buildout:${BUILD_OUT_BASE}"
    # Mount scripts/ separately so uncommitted edits are live without a full
    # image rebuild. patches/ is also needed when PATCH_DIRS references it.
    -v "${REPO_ROOT}/scripts:/kernel-tools/scripts:ro"
    -v "${REPO_ROOT}/patches:/kernel-tools/patches:ro"
    -w /kernel-tools
)

# Bind-mount host kernel headers when not baked into the image.
if [ "${HEADERS_IN_IMAGE}" != "yes" ]; then
    DOCKER_ARGS+=(
        -v "${KMOD_HOST}:${KMOD_HOST}:ro"
        -v "${KHDRS_HOST}:${KHDRS_HOST}:ro"
    )
fi

# When BUILD_SRC is supplied, bind-mount it read-only inside the container.
if [ -n "${BUILD_SRC}" ]; then
    DOCKER_ARGS+=(-v "${BUILD_SRC}:/mnt/staged-src:ro")
    DOCKER_ARGS+=(-e "BUILD_SRC=/mnt/staged-src")
fi

# When KERNEL_DIR is supplied (git archive staging path), bind-mount it
# read-only so fast-build-amdgpu can run git archive inside the container.
# Add a safe.directory override so git does not refuse to operate on a repo
# owned by the host user when the container runs as root (git >= 2.35.2).
if [ -n "${KERNEL_DIR}" ]; then
    DOCKER_ARGS+=(-v "${KERNEL_DIR}:/mnt/kernel-src:ro")
    DOCKER_ARGS+=(-e "KERNEL_DIR=/mnt/kernel-src")
    # git >= 2.35.2 rejects repos owned by a different user.  When the
    # container runs as root but the bind-mount is owned by the host user,
    # mark the path safe via GIT_CONFIG_COUNT / GIT_CONFIG_KEY/VALUE.
    DOCKER_ARGS+=(
        -e "GIT_CONFIG_COUNT=1"
        -e "GIT_CONFIG_KEY_0=safe.directory"
        -e "GIT_CONFIG_VALUE_0=/mnt/kernel-src"
    )
fi

# Patch dirs: each host path is bind-mounted at the same path inside the
# container (patches are already inside the repo, so the repo bind-mount
# covers them, but PATCH_DIRS may reference absolute paths outside the repo).
if [ -n "${PATCH_DIRS}" ]; then
    DOCKER_ARGS+=(-e "PATCH_DIRS=${PATCH_DIRS}")
fi

# ---------------------------------------------------------------------------
echo "=== docker-fast-build-amdgpu ==="
echo "  Image:      ${IMAGE}"
echo "  KERNEL_VER: ${KERNEL_VER}"
echo "  BUILD_SRC:  ${BUILD_SRC:-<from git>}"
echo "  FORCE:      ${FORCE}"
echo ""

docker run "${DOCKER_ARGS[@]}" "${IMAGE}" \
    bash scripts/fast-build-amdgpu
