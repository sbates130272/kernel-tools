#!/bin/bash
#
# (c) Stephen Bates, 2026
#
# Stage the amdgpu DKMS source from a GitHub release tarball into the
# DKMS layout expected by fast-build-amdgpu and build-amdgpu-dkms.
#
# Avoids all git operations inside CI containers — no clone, no git
# archive, no dubious-ownership issues, no partial-clone failures.
#
# The tarball is fetched from GitHub's archive endpoint.  Tags and branch
# heads are both supported; tags are tried first.
#
# Usage:
#   ./scripts/stage-amdgpu-from-tarball <amdgpu-ref> <output-dir>
#
# Example:
#   ./scripts/stage-amdgpu-from-tarball rocm-6.2.4 /tmp/amdgpu-staged
#   ./scripts/stage-amdgpu-from-tarball therock-7.14 /tmp/amdgpu-staged
#
# Output directory layout (DKMS source tree):
#   amd/          — AMD GPU driver + DKMS build system
#   ttm/          — TTM memory manager
#   scheduler/    — GPU scheduler
#   include/      — kcl, drm, uapi headers
#   drm_*.c       — out-of-tree DRM core files
#   Makefile      — symlink → amd/dkms/Makefile
#   dkms.conf     — symlink → amd/dkms/dkms.conf
#   configure     — generated by autoconf (required by pre-build.sh)
#
# Dependencies: curl, tar, autoconf, automake (aclocal, autoheader)
#

set -eo pipefail

AMDGPU_REF=${1:?'Usage: stage-amdgpu-from-tarball <amdgpu-ref> <output-dir>'}
OUTPUT_DIR=${2:?'Usage: stage-amdgpu-from-tarball <amdgpu-ref> <output-dir>'}

REPO="ROCm/amdgpu"
TAG_URL="https://github.com/${REPO}/archive/refs/tags/${AMDGPU_REF}.tar.gz"
HEAD_URL="https://github.com/${REPO}/archive/refs/heads/${AMDGPU_REF}.tar.gz"

info()  { echo "  INFO: $*"; }
die()   { echo "Error. $*" >&2; exit 1; }

for cmd in curl tar autoconf automake aclocal autoheader; do
    command -v "${cmd}" &>/dev/null || die "${cmd} not installed."
done

# ---------------------------------------------------------------------------
# Download tarball — try tag first, fall back to head
# ---------------------------------------------------------------------------
WORK=$(mktemp -d)
trap 'rm -rf "${WORK}"' EXIT

TARBALL="${WORK}/amdgpu.tar.gz"
info "Fetching ${AMDGPU_REF} from GitHub..."
if curl -fsSL -o "${TARBALL}" "${TAG_URL}" 2>/dev/null; then
    info "Downloaded tag tarball: ${TAG_URL}"
elif curl -fsSL -o "${TARBALL}" "${HEAD_URL}" 2>/dev/null; then
    info "Downloaded head tarball: ${HEAD_URL}"
else
    die "Could not fetch tarball for ref '${AMDGPU_REF}' from ${REPO}."
fi

# ---------------------------------------------------------------------------
# Extract full source tree to a work directory
# GitHub tarballs have a single top-level directory (<repo>-<ref>/);
# strip it with --strip-components=1.
# ---------------------------------------------------------------------------
SRC="${WORK}/src"
mkdir -p "${SRC}"
info "Extracting tarball..."
tar -xzf "${TARBALL}" --strip-components=1 -C "${SRC}"

# ---------------------------------------------------------------------------
# Produce DKMS-layout staging directory
# Mirrors the extraction done by stage_source in fast-build-amdgpu and
# build-amdgpu-dkms using git archive.
# ---------------------------------------------------------------------------
info "Staging DKMS source to ${OUTPUT_DIR}..."
rm -rf "${OUTPUT_DIR}"
mkdir -p "${OUTPUT_DIR}" \
         "${OUTPUT_DIR}/include/kcl" \
         "${OUTPUT_DIR}/include/drm" \
         "${OUTPUT_DIR}/include/uapi/drm" \
         "${OUTPUT_DIR}/include/uapi/linux" \
         "${OUTPUT_DIR}/amd/amdkcl/dma-buf" \
         "${OUTPUT_DIR}/include/linux"

_cp_tree() {
    local src_path="$1" dst="$2" strip="$3"
    local full="${SRC}/${src_path}"
    [ -e "${full}" ] || { info "  (skipping missing: ${src_path})"; return 0; }
    tar -c -C "${SRC}" "${src_path}" \
        | tar -x --strip-components="${strip}" -C "${dst}"
}

_cp_file() {
    local src_path="$1" dst="$2" strip="$3"
    local full="${SRC}/${src_path}"
    [ -f "${full}" ] || { info "  (skipping missing: ${src_path})"; return 0; }
    tar -c -C "${SRC}" "${src_path}" \
        | tar -x --strip-components="${strip}" -C "${dst}"
}

# Main AMD subtrees (strip drivers/gpu/drm/ = 3 components)
_cp_tree drivers/gpu/drm/amd       "${OUTPUT_DIR}"            3
_cp_tree drivers/gpu/drm/ttm       "${OUTPUT_DIR}"            3
_cp_tree drivers/gpu/drm/scheduler "${OUTPUT_DIR}"            3

# Out-of-tree DRM core files
for f in drm_gem_ttm_helper.c drm_buddy.c drm_exec.c drm_suballoc.c; do
    _cp_file "drivers/gpu/drm/${f}" "${OUTPUT_DIR}" 3
done

# kcl headers (strip include/ = 1 component)
_cp_tree include/kcl "${OUTPUT_DIR}/include" 1

# drm headers
_cp_tree include/drm/ttm "${OUTPUT_DIR}/include/drm" 2
for f in amd_asic_type.h amd_rdma.h spsc_queue.h \
          drm_buddy.h drm_exec.h drm_gem_ttm_helper.h gpu_scheduler.h; do
    _cp_file "include/drm/${f}" "${OUTPUT_DIR}/include/drm" 2
done

# uapi headers
_cp_file include/uapi/drm/amdgpu_drm.h "${OUTPUT_DIR}/include/uapi/drm" 3
for f in kfd_ioctl.h kfd_sysfs.h; do
    _cp_file "include/uapi/linux/${f}" "${OUTPUT_DIR}/include/uapi/linux" 3
done

# dma-resv
_cp_file drivers/dma-buf/dma-resv.c "${OUTPUT_DIR}/amd/amdkcl/dma-buf" 2
_cp_file include/linux/dma-resv.h   "${OUTPUT_DIR}/include/linux"       2

# ---------------------------------------------------------------------------
# Symlinks and autotools
# ---------------------------------------------------------------------------
info "Setting up Makefile, dkms.conf symlinks..."
ln -sf amd/dkms/Makefile  "${OUTPUT_DIR}/Makefile"
ln -sf amd/dkms/dkms.conf "${OUTPUT_DIR}/dkms.conf"

info "Generating configure script..."
(cd "${OUTPUT_DIR}/amd/dkms" && \
    aclocal -I m4 && \
    autoheader && \
    autoconf -o configure configure.ac)

info "Staging complete: ${OUTPUT_DIR}"
