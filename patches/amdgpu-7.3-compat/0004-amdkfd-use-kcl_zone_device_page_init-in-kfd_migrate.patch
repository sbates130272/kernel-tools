Replace zone_device_page_init() with kcl wrapper in kfd_migrate.c.

kfd_migrate.c calls zone_device_page_init(page) with one argument.  In
v7.x kernels the exported function requires three arguments (page, pgmap,
order), so the direct call no longer compiles.

Replace the direct call with kcl_zone_device_page_init(page), which is
the wrapper added in kcl_mm.h that routes to the correct kernel call form.
Add the kcl_mm.h include so the wrapper is visible.

--- a/amd/amdkfd/kfd_migrate.c
+++ b/amd/amdkfd/kfd_migrate.c
@@ -26,6 +26,7 @@
 #include <linux/dma-direction.h>
 #include <linux/dma-mapping.h>
 #include <linux/migrate.h>
+#include <kcl/kcl_mm.h>
 #include "amdgpu_sync.h"
 #include "amdgpu_object.h"
 #include "amdgpu_vm.h"
@@ -222,7 +223,7 @@ svm_migrate_get_vram_page(struct svm_range *prange, unsigned long pfn)
 	page = pfn_to_page(pfn);
 	svm_range_bo_ref(prange->svm_bo);
 	page->zone_device_data = prange->svm_bo;
-	zone_device_page_init(page);
+	kcl_zone_device_page_init(page);
 }
