--- a/include/kcl/kcl_drm_client_event.h	2026-10-20 08:45:47.309402437 -0600
+++ b/include/kcl/kcl_drm_client_event.h	2026-10-20 08:46:43.537775095 -0600
@@ -2,11 +2,36 @@
 #ifndef KCL_KCL_DRM_CLIENT_EVENT_H
 #define KCL_KCL_DRM_CLIENT_EVENT_H
 
+#include <linux/version.h>
 #include <drm/drm_fb_helper.h>
 
 #ifndef HAVE_DRM_CLIENT_DEV_RESUME
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 2, 0)
+/*
+ * 7.2+ dropped holds_console_lock from drm_client_dev_suspend/resume.
+ * The kernel header provides 1-arg versions; define 2-arg wrappers here
+ * under different internal names so that call sites continue to compile
+ * without change.
+ */
+#include <drm/drm_client_event.h>
+static inline void _kcl_drm_client_dev_suspend(struct drm_device *dev,
+						bool holds_console_lock)
+{
+	drm_client_dev_suspend(dev);
+}
+static inline void _kcl_drm_client_dev_resume(struct drm_device *dev,
+					       bool holds_console_lock)
+{
+	drm_client_dev_resume(dev);
+}
+#undef drm_client_dev_suspend
+#undef drm_client_dev_resume
+#define drm_client_dev_suspend _kcl_drm_client_dev_suspend
+#define drm_client_dev_resume  _kcl_drm_client_dev_resume
+#else
 void drm_client_dev_suspend(struct drm_device *dev, bool holds_console_lock);
 void drm_client_dev_resume(struct drm_device *dev, bool holds_console_lock);
-#endif
+#endif /* LINUX_VERSION_CODE */
+#endif /* HAVE_DRM_CLIENT_DEV_RESUME */
 
 #endif
--- a/amd/amdkcl/kcl_drm_client_event.c	2026-10-20 08:45:47.313406213 -0600
