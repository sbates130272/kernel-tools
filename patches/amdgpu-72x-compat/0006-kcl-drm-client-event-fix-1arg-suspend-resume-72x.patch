@@ -1,6 +1,10 @@
+#include <linux/version.h>
 #include <kcl/kcl_drm_client_event.h>
 
 #ifndef HAVE_DRM_CLIENT_DEV_RESUME
+#if LINUX_VERSION_CODE < KERNEL_VERSION(7, 2, 0)
+/* On 7.2+ the kernel provides drm_client_dev_suspend/resume with a single
+ * argument; the kcl header provides inline wrappers for the 2-arg callers. */
 void drm_client_dev_resume(struct drm_device *dev, bool holds_console_lock)
 {
 	drm_fb_helper_set_suspend_unlocked(dev->fb_helper, holds_console_lock);
@@ -13,4 +17,5 @@
 	drm_fb_helper_set_suspend_unlocked(dev->fb_helper, suspend);
 }
 EXPORT_SYMBOL(drm_client_dev_suspend);
-#endif
+#endif /* LINUX_VERSION_CODE */
+#endif /* HAVE_DRM_CLIENT_DEV_RESUME */
